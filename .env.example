# vLLM
# v1 style model (language + gender input style)
VLLM_MODEL=kenpath/svara-tts-v1
# v0.5 style model (voice_name input style)
# VLLM_MODEL=kenpath/voice-svara-tts-v1-fft-v0.5
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=2048
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_TRUST_REMOTE_CODE=true
VLLM_DTYPE=auto
VLLM_QUANTIZATION=
VLLM_ENFORCE_EAGER=true

# API
API_HOST=0.0.0.0
API_PORT=8080

# TTS
TTS_DEVICE=cuda

# HF
HF_TOKEN=

# Logging
LOG_LEVEL=INFO
